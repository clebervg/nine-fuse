# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Artefatos de golden que falhou. O flutter_test cria esta pasta sozinho ao
# lado do golden divergente, com quatro PNGs de diagnóstico (master, test,
# masked e isolated diff). São descartáveis por natureza: só valem enquanto
# a falha está na tela, e são regerados na próxima execução. Quatro deles
# chegaram a ser commitados por acidente — daí a regra existir.
test/**/failures/
.worktrees/

# Rascunhos e estado de ferramentas: existem no disco de quem os usa, mas não
# fazem parte do app. `tool_tmp/probe124.dart` era o único aviso do analyze.
tool_tmp/
tool/dbg_scratch/
.superpowers/

# Pacotes de arte baixados da ferramenta de design (dezenas de MB): ficam no disco
# de quem os extraiu, mas o conteúdo útil já está nos assets versionados.
assets/*.zip

# IDs de produção do build (tool/build_release.sh). Não são segredo, mas
# variam por conta e não pertencem ao histórico.
/release.env.json
